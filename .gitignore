# Rust Build Artefakte
/tauri-app/src-tauri/target/

# Node Abhaengigkeiten des Remotion Projekts, inklusive des von Remotion
# selbst heruntergeladenen headless Chromium unter node_modules/.remotion/.
# Wird lokal per "npm install" im Ordner tauri-app/remotion neu erzeugt,
# siehe docs/ARCHITEKTUR.md.
/tauri-app/remotion/node_modules/

# Sidecar Binaerdateien selbst werden nicht versioniert, nur per
# BAUANLEITUNG.md (analog NovaPhonic) besorgt und lokal abgelegt.
/tauri-app/src-tauri/binaries/*
!/tauri-app/src-tauri/binaries/.gitkeep

# Von Tauri automatisch beim Build erzeugte Schema Dateien.
/tauri-app/src-tauri/gen/

# Dateien, die nur JJ und Claude persoenlich betreffen, gehoeren nicht in ein
# oeffentliches Repository.
MEMORY.md
GITHUB_SETUP.md

# Das private Signierschluesselpaar fuer automatische Updates. Der zugehoerige
# oeffentliche Schluessel steht bereits in tauri-app/src-tauri/tauri.conf.json,
# der private Teil darf niemals ins Repository, auch nicht in ein spaeter
# oeffentliches. Er wird stattdessen als GitHub Actions Secret hinterlegt,
# siehe GITHUB_SETUP.md.
novastudiocast_updater.key
*.key
